# AVA CDN — Environment template
# Copy to /opt/ava-cdn/.env on the server (chmod 600). Never commit real values.

# Server role: kharej | iran
AVA_ROLE=kharej

# Deployment mode: cdn-origin | proxy-panel | rathole-relay | iptables-relay
AVA_MODE=cdn-origin

# Public endpoints
AVA_PUBLIC_IP=
AVA_DOMAIN=

# Kharej / CDN Origin
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
ORIGIN_UPSTREAM=127.0.0.1:8080

# 3x-ui panel (optional)
XUI_PANEL_PORT=
XUI_ADMIN_USER=
XUI_ADMIN_PASS=

# Rathole tunnel (optional — separate from CDN traffic)
RATHOLE_TOKEN=
RATHOLE_TUNNEL_PORT=2096
RATHOLE_SERVICE_PORT=443
RATHOLE_IRAN_IP=

# Iran iptables relay (optional)
RELAY_PORTS=443,8443

# Monitoring
NODE_EXPORTER_PORT=9100
